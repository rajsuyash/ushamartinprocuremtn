{
  "name": "pdi",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "pnpm --filter @pdi/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:seed": "vitest run seed",
    "seed": "tsx seed/index.ts"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "bcryptjs": "^3.0.2",
    "postgres": "^3.4.9",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
