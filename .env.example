# Copy to .env and fill. App fails fast on missing required vars — no silent fallbacks.
DATABASE_URL=          # Postgres connection, web + engine — Compose default / client VM (PRD ENV-1)
ENGINE_URL=            # Web → engine base URL, Compose default http://engine:8000 (PRD ENV-2)
AUTH_SECRET=           # Auth.js JWT signing, generated per deploy (PRD ENV-3)
ANTHROPIC_API_KEY=     # F9 memo; unset = template mode with visible notice (PRD ENV-4)
MEMO_MODEL=            # Model id pin for F9, defaults to claude-sonnet-4-6 (PRD ENV-5)
APP_ENV=               # development|production toggles, defaults to development (PRD ENV-6)
